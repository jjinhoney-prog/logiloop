NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — 상담·파트너 신청 메일 전달 (서버 전용, 값은 .env.local과 Vercel에만)
RESEND_API_KEY=
# 받는 주소. 쉼표로 여러 개. Resend 테스트 모드에서는 Resend 가입 이메일만 수신 가능
INQUIRY_TO_EMAIL=

# 카카오맵 JavaScript 키 — 앱 설정의 Web 사이트 도메인으로 보호되므로 NEXT_PUBLIC_ 허용
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 카카오 REST API 키 — 카카오모빌리티 길찾기 (서버 전용)
KAKAO_REST_KEY=

# Supabase — 매물·상담 DB (서버 전용. NEXT_PUBLIC_ 금지, anon 키 미사용)
# Project Settings → API의 Project URL과 service_role 키. Vercel에는 Sensitive로 등록
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 관리자(/admin) 로그인 — 서버 전용. 비밀번호를 바꾸면 기존 로그인이 모두 끊김
ADMIN_PASSWORD=
# 세션 서명 키 32자 이상. 생성 예: openssl rand -base64 48
SESSION_SECRET=
